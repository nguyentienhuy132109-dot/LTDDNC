<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Ghi Điện Nước"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Dữ liệu được lưu cục bộ, dùng được khi không có mạng."
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />

        <EditText
            android:id="@+id/edtMonthYear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tháng/Năm (VD: 11/2026)"
            android:inputType="text"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/edtNewElec"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Chỉ số điện mới (kWh)"
            android:inputType="numberDecimal"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/edtNewWater"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Chỉ số nước mới (m³)"
            android:inputType="numberDecimal"
            android:minHeight="48dp" />

        <Button
            android:id="@+id/btnCapturePhoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Chụp ảnh công tơ"
            android:backgroundTint="@color/accent" />

        <ImageView
            android:id="@+id/imgPreviewMeter"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="12dp"
            android:background="#E0E0E0"
            android:scaleType="centerCrop"
            android:contentDescription="Ảnh xem trước công tơ điện nước" />

        <Button
            android:id="@+id/btnSaveUtility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Lưu chỉ số"
            android:backgroundTint="@color/primary" />
    </LinearLayout>
</ScrollView>